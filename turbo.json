{
  "$schema": "https://turborepo.com/schema.json",
  "cacheDir": ".turbo/cache",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "VITE_*",
        "NITRO_PRESET",
        "VERCEL",
        "VERCEL_*"
      ],
      "outputs": [
        ".output/**",
        ".vercel/output/**",
        "$TURBO_ROOT$/.vercel/output/**"
      ],
      "passThroughEnv": [
        "CLERK_SECRET_KEY"
      ]
    },
    "check": {
      "dependsOn": [
        "^check"
      ],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "VITE_*",
        "CLERK_SECRET_KEY"
      ]
    }
  }
}
