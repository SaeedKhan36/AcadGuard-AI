# Vite exposes only variables prefixed with VITE_ to the browser.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
VITE_CLERK_SIGN_IN_URL=/auth/login
VITE_CLERK_SIGN_UP_URL=/auth/register
VITE_CLERK_AFTER_SIGN_IN_URL=/dashboard
VITE_CLERK_AFTER_SIGN_UP_URL=/dashboard
# CLERK_SECRET_KEY is not needed by this frontend. Keep it in your Rust server environment.
