# Browser-safe Clerk configuration
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
VITE_CLERK_SIGN_IN_URL=/auth/login
VITE_CLERK_SIGN_UP_URL=/auth/register
VITE_CLERK_AFTER_SIGN_IN_URL=/dashboard
VITE_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Required by TanStack Start's Clerk server middleware. Never prefix secrets with VITE_.
CLERK_SECRET_KEY=

# Existing Convex project. Copy the frontend URL from its dashboard.
VITE_CONVEX_URL=
# Set by `npx convex dev --configure existing`; use the development deployment locally.
CONVEX_DEPLOYMENT=

# Set this on the Convex deployment (Convex Dashboard > Settings > Environment Variables).
# It is your Clerk Frontend API URL, not a secret key.
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
