{
  "name": "acadguard-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@acadguard/web",
    "check": "turbo run check",
    "test": "turbo run test",
    "preview": "pnpm --filter @acadguard/web preview",
    "engine": "pnpm --filter @acadguard/plagengine cli",
    "demo:engine": "pnpm --filter @acadguard/plagengine demo",
    "typecheck": "turbo run check",
    "start": "pnpm --filter @acadguard/web start",
    "convex:dev": "pnpm --filter @acadguard/web convex:dev",
    "convex:deploy": "pnpm --filter @acadguard/web convex:deploy",
    "convex:codegen": "pnpm --filter @acadguard/web convex:codegen"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
