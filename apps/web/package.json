{
  "name": "@acadguard/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js dev --host 127.0.0.1 --port 5173",
    "build": "vite build && pnpm typecheck",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "start": "node --env-file-if-exists=.env.local .output/server/index.mjs",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:codegen": "convex codegen",
    "check": "pnpm typecheck"
  },
  "dependencies": {
    "@clerk/tanstack-react-start": "^1.7.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "convex": "^1.48.0",
    "lucide-react": "^0.468.0",
    "nitro": "3.0.260903-beta",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.64",
    "typescript": "~5.9.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
